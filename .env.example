# Sao chép file này thành ".env" rồi điền giá trị thật.
# Không có 2 biến đầu -> web chạy chế độ cục bộ (file JSON + thư mục uploads/).

# --- MongoDB Atlas (miễn phí) : lưu danh sách ảnh / kỷ niệm / hẹn hò ---
# Tạo cluster free tại https://cloud.mongodb.com -> Connect -> Drivers -> copy chuỗi
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=thuvien_anh

# --- Cloudinary (miễn phí) : lưu file ảnh gốc + tự tạo thumbnail ---
# Dashboard https://cloudinary.com/console -> mục "API Environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=thuvien-anh

# --- Khác ---
SESSION_SECRET=chuoi-ngau-nhien-that-dai-doi-di
# PORT=5000
